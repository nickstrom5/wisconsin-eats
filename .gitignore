# Xcode (the project is generated from project.yml)
*.xcodeproj
DerivedData*/
build/
xcuserdata/
.DS_Store

# Python
.venv/
__pycache__/

# Large or regenerable data (see README "Rebuild")
data/*.json.gz
data/*.log
data/wi/*.parquet
data/wi/*.pkl
data/wi/*.log
data/raw/official/*/
!data/raw/official/_scripts/
data/app/
data/research/geocode_todo.json

# Screenshot review copies
docs/screenshots/small-*.png

# The web leaderboard's data carries Google Local 2021-derived ratings. It is regenerated by pipeline/wisconsin.py
# and published only as a private Artifact, so it stays out of the repo (which may become public for GitHub Pages).
site/*.json

# Aggregate rates measured against Google 2021 data: used by the private leaderboard build only (the app uses calibration_app.json)
data/wi/calibration.json
